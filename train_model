๊กใน Kaggle\nsettings.update({'raytune': False})\n\n# --- 1. กำหนด Path ต้นทาง (Read-only) และ ปลายทางที่เขียนได้ ---\nsource_dataset_path = '/kaggle/input/datasets/switchonchannel/9dataset-v9-polygonv1'\nwritable_dataset_path = '/kaggle/working/9data-v9-polygon'\n\nprint(f\"🔍 ตรวจสอบ Dataset ต้นทางที่: {source_dataset_path} ...\")\n\nif os.path.exists(source_dataset_path):\n    print(\"✅ เจอ Dataset ต้นทางแล้ว!\")\n    \n    # 2. ทำการคัดลอก Dataset มาไว้ใน /kaggle/working เพื่อหลีกเลี่ยงข้อผิดพลาด Read-only\n    if not os.path.exists(writable_dataset_path):\n        print(\"📦 กำลังคัดลอก Dataset ไปยังพื้นที่ทำงานที่เขียนได้... (ขั้นตอนนี้อาจใช้เวลาสักครู่)\")\n        shutil.copytree(source_dataset_path, writable_dataset_path)\n        print(\"✅ คัดลอกโฟลเดอร์เรียบร้อย!\")\n    else:\n        print(\"ℹ️ โฟลเดอร์ Dataset ในพื้นที่ทำงานมีอยู่แล้ว ไม่ต้องคัดลอกซ้ำ\")\n\n    # เปลี่ยนไปใช้ Path ของโฟลเดอร์ตัวใหม่ที่คัดลอกมา\n    dataset_path = writable_dataset_path\n\n    # --- 2. สร้างไฟล์ data.yaml ด้วย Path เต็ม ---\n    train_path = os.path.join(dataset_path, 'train', 'images')\n    val_path = os.path.join(dataset_path, 'valid', 'images')\n    test_path = os.path.join(dataset_path, 'test', 'images')\n\n    # รายชื่อ Class ทั้ง 9 โรค\n    names = ['Bacterial_Blight', 'Brown_Spot', 'Rice_Blast', 'Narrow_Brown_Spot', 'False_Smut', 'Dirty_Seed', 'Sheath_Rot', 'Stem_Rot', 'Red_Stripe']\n    \n    # เขียนไฟล์ data.yaml\n    yaml_content = {\n        'train': train_path,\n        'val': val_path,\n        'test': test_path,\n        'nc': len(names),\n        'names': names\n    }\n\n    # บันทึก data.yaml ไว้ที่ /kaggle/working เพื่อให้โมเดลเรียกใช้ได้\n    with open('/kaggle/working/data.yaml', 'w') as f:\n        yaml.dump(yaml_content, f, sort_keys=False) \n\n    print(\"✅ สร้างไฟล์ data.yaml เรียบร้อย\")\n    print(f\"   Train: {train_path}\")\n    print(f\"   Val:   {val_path}\")\n\n# --- 3. โหลดโมเดลและเริ่มเทรน ---\n    print(\"\\n🚀 เริ่มเทรนโมเดล...\")\n    \n    # [จุดแก้ที่ 1] ต้องใช้ไฟล์โมเดลรุ่น Segmentation (สังเกต -seg)\n    # หาก yolo26l.pt ของคุณเป็นรุ่น seg อยู่แล้ว สามารถใช้ path เดิมได้\n    # แต่ถ้าไม่ใช่ แนะนำให้โหลด pre-trained ตัวใหม่ของ YOLO มาเริ่มเทรนเลยครับ\n    model = YOLO('yolo26l-seg.pt') # หรือ 'yolo11l-seg.pt'\n\n    model.train(\n        task='segment',      # [จุดแก้ที่ 2] บังคับ Task ให้เป็น Segmentation\n        data='/kaggle/working/data.yaml',\n        epochs=100,\n        imgsz=800,\n        batch=8,\n        device=[0, 1],\n        patience=20,\n        project='/kaggle/working/runs',\n        name='Model_rice9diseasev9_Polygon' # เติม _seg ไว้ที่ชื่อรันจะได้ไม่งงกับรอบก่อนหน้า\n    )\n\n    # --- 4. ตรวจสอบผล (Validation) ---\n    print(\"\\n📊 กำลังประเมินผลลัพธ์ (Validation)...\")\n    metrics = model.val(conf=0.1)\n    \n    print(\"-\" * 30)\n    # [จุดแก้ที่ 3] เปลี่ยนจากการดึงค่า .box เป็น .seg เพื่อดูความแม่นยำของ Polygon\n    print(f\"Polygon mAP50-95: {metrics.seg.map:.4f}\")\n    print(f\"Polygon mAP50:    {metrics.seg.map50:.4f}\")\n    \n    # แถม: คุณยังสามารถดูความแม่นยำของ Bounding Box ควบคู่ไปได้ด้วย\n    print(f\"Box mAP50-95:     {metrics.box.map:.4f}\")\n    print(\"-\" * 30)\n\nelse:\n    print(f\"❌ Error: ไม่พบ Dataset ที่ {source_dataset_path} โปรดตรวจสอบชื่อโฟลเดอร์อีกครั้ง\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-03T09:11:08.764889Z","iopub.execute_input":"2026-09-03T09:11:08.765096Z","iopub.status.idle":"2026-09-03T11:55:02.975254Z","shell.execute_reply.started":"2026-09-03T09:11:08.765076Z","shell.execute_reply":"2026-09-03T11:55:02.974419Z"}},"outputs":[{"name":"stdout","text":"\u001b[2K     \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m46.0/46.0 kB\u001b[0m \u001b[31m1.7 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m1.4/1.4 MB\u001b[0m \u001b[31m23.8 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0ma \u001b[36m0:00:01\u001b[0m\n\u00